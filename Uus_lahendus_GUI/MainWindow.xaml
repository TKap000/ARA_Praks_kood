<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab Management" Height="450" Width="750">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Remote Computer Status" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <ListView x:Name="ComputerList" Grid.Row="1">
            <ListView.View>
                <GridView>
                <!-- eemalda kui ei ole vaja linnukest -->
                        <GridViewColumn Header="" Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                <!-- eemalda kui ei ole vaja linnukest -->
                
                        <GridViewColumn Header="Status" Width="60" DisplayMemberBinding="{Binding Status}" />
                        <GridViewColumn Header="Computer Name" Width="150" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Progress" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="300">
                                        <ProgressBar Value="{Binding Progress}"
                                                     Minimum="0" Maximum="100"
                                                     Height="20" Width="300"
                                                     Foreground="#0078D7"
                                                     Background="#E0E0E0"
                                                     BorderThickness="1" BorderBrush="#888888"/>
                                        <TextBlock Text="{Binding Action}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" 
                                                   FontSize="11" Foreground="Black" FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                </GridView>
            </ListView.View>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="OK">
                            <Setter Property="Background" Value="#2E7D32"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="FAIL">
                            <Setter Property="Background" Value="#C62828"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="BUSY">
                            <Setter Property="Background" Value="#EF6C00"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="DONE">
                            <Setter Property="Background" Value="#00fb0d"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <CheckBox x:Name="SelectAllChk" Content="Restart ALL online computers" Margin="5" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ScanBtn" Content="Scan" Width="80" Margin="5"/>
                <Button x:Name="RestoreVHDBtn" Content="Restore VHD" Width="100" Margin="5"/>
                <Button x:Name="RestartToAdminBtn" Content="Restart Admin" Width="100" Margin="5"/>
                <Button x:Name="ExitBtn" Content="Exit" Width="80" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>